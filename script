// ==UserScript==
// @name         Site Dashboard + Cloak Toggle (Full)
// @namespace    dashboard-full
// @version      2.1
// @description  Cloak toggle + stats overlay
// @match        *://discord.com/*
// @match        *://*.discord.com/*
// @match        *://vrchat.com/*
// @match        *://*.vrchat.com/*
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    // =========================
    // STARTUP TERMINAL
    // =========================

    function showStartup(callback) {

        const startup = document.createElement("div");

        startup.innerHTML = `
            <div id="noober-startup">
                <div class="topbar">
                    TERMINAL
                </div>

                <div class="content">
                    <div>> made by noober_31524</div>
                    <div>> don't edit or promote as yours</div>
                </div>
            </div>
        `;

        const style = document.createElement("style");

        style.textContent = `
            #noober-startup{
                position:fixed;
                top:50%;
                left:50%;
                transform:translate(-50%,-50%) scale(0.95);
                width:420px;
                background:#050505;
                border:2px solid #00ff66;
                color:#00ff66;
                font-family:monospace;
                z-index:999999999;
                box-shadow:0 0 35px #00ff66;
                opacity:0;
                transition:
                    opacity 0.5s ease,
                    transform 0.5s ease;
            }

            #noober-startup.show{
                opacity:1;
                transform:translate(-50%,-50%) scale(1);
            }

            #noober-startup.hide{
                opacity:0;
                transform:translate(-50%,-50%) scale(0.92);
            }

            #noober-startup .topbar{
                background:#00ff66;
                color:black;
                padding:8px;
                font-weight:bold;
            }

            #noober-startup .content{
                padding:18px;
                line-height:1.8;
                font-size:14px;
            }
        `;

        document.documentElement.appendChild(style);
        document.documentElement.appendChild(startup);

        const terminal = document.getElementById("noober-startup");

        setTimeout(() => {
            terminal.classList.add("show");
        }, 50);

        setTimeout(() => {

            terminal.classList.remove("show");
            terminal.classList.add("hide");

            setTimeout(() => {

                startup.remove();
                style.remove();

                callback();

            }, 500);

        }, 2000);
    }

    // =========================
    // MAIN SCRIPT
    // =========================

    function startMainScript() {

        const ICON = "https://www.youtube.com/favicon.ico";

        let cloaked = false;
        let toggleCount = 0;
        const startTime = Date.now();

        // ---------- UI ----------

        const box = document.createElement("div");

        box.style = `
            position: fixed;
            bottom: 10px;
            right: 10px;
            width: 240px;
            z-index: 999999;
            background: rgba(0,0,0,0.85);
            color: white;
            font-family: Arial;
            font-size: 12px;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #333;
            backdrop-filter: blur(4px);
        `;

        const btn = document.createElement("button");

        btn.innerText = "Toggle Cloak";

        btn.style = `
            width:100%;
            padding:6px;
            margin-bottom:8px;
            cursor:pointer;
            border:none;
            border-radius:5px;
        `;

        const info = document.createElement("div");

        box.appendChild(btn);
        box.appendChild(info);

        document.documentElement.appendChild(box);

        // ---------- CLOAK ----------

        function applyCloak() {

            if (!cloaked) return;

            document.title = "YouTube";

            let link =
                document.querySelector("link[rel*='icon']");

            if (!link) {

                link = document.createElement("link");
                document.head.appendChild(link);
            }

            link.rel = "icon";
            link.href = ICON;
        }

        btn.onclick = () => {

            cloaked = !cloaked;
            toggleCount++;

            applyCloak();
        };

        // ---------- BATTERY ----------

        let batteryText = "Battery: unknown";

        if (navigator.getBattery) {

            navigator.getBattery().then(battery => {

                function updateBattery() {

                    batteryText =
                        `Battery: ${Math.round(battery.level * 100)}% ` +
                        (battery.charging
                            ? "(Charging)"
                            : "(Not charging)");
                }

                updateBattery();

                battery.addEventListener(
                    "levelchange",
                    updateBattery
                );

                battery.addEventListener(
                    "chargingchange",
                    updateBattery
                );
            });
        }

        // ---------- WEATHER ----------

        let weatherText = "Weather: loading...";

        async function loadWeather() {

            try {

                navigator.geolocation.getCurrentPosition(

                    async pos => {

                        const lat = pos.coords.latitude;
                        const lon = pos.coords.longitude;

                        const url =
                            `https://api.open-meteo.com/v1/forecast` +
                            `?latitude=${lat}&longitude=${lon}` +
                            `&current_weather=true&temperature_unit=fahrenheit`;

                        const res = await fetch(url);
                        const data = await res.json();

                        const w = data.current_weather;

                        weatherText =
                            `Weather: ${Math.round(w.temperature)}°F | Wind ${w.windspeed}`;
                    },

                    () => {
                        weatherText =
                            "Weather: location blocked";
                    }
                );

            } catch (e) {

                weatherText = "Weather: error";
            }
        }

        loadWeather();

        setInterval(loadWeather, 600000);

        // ---------- LOOP ----------

        setInterval(() => {

            const secondsOpen =
                Math.floor(
                    (Date.now() - startTime) / 1000
                );

            info.innerHTML = `
                ${cloaked
                    ? "🟢 Cloak: ON"
                    : "🔴 Cloak: OFF"}<br>

                Toggles: ${toggleCount}<br>

                Time open: ${secondsOpen}s<br>

                ${batteryText}<br>

                ${weatherText}
            `;

            applyCloak();

        }, 1000);
    }

    // START
    showStartup(startMainScript);

})();

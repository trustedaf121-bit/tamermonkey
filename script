// Replace ONLY the startup CSS section with this

style.textContent = `
    #noober-startup{
        position:fixed;
        top:0;
        left:0;
        width:100vw;
        height:100vh;
        background:#050505;
        color:#00ff66;
        font-family:monospace;
        z-index:999999999;
        opacity:0;
        transition:opacity 0.5s ease;
        overflow:hidden;
    }

    #noober-startup.show{
        opacity:1;
    }

    #noober-startup.hide{
        opacity:0;
    }

    #noober-startup .topbar{
        width:100%;
        background:#00ff66;
        color:black;
        padding:12px;
        font-size:18px;
        font-weight:bold;
        box-sizing:border-box;
        box-shadow:0 0 20px #00ff66;
    }

    #noober-startup .content{
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        text-align:center;
        font-size:28px;
        line-height:2;
        text-shadow:0 0 10px #00ff66;
        animation:flicker 1.5s infinite alternate;
    }

    @keyframes flicker{
        0%{opacity:1;}
        50%{opacity:0.85;}
        100%{opacity:1;}
    }
`;
